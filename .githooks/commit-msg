#!/bin/sh
# Conventional Commits check - installed by bzcom-lint-config
# Types kept in step with configs/shared/commitlint.cjs

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Let merge, revert and fixup commits through untouched.
case "$first_line" in
    'Merge '*|'Revert '*|'fixup!'*|'squash!'*) exit 0 ;;
esac

# Strip comment lines git adds to the template.
case "$first_line" in '#'*) exit 0 ;; esac

pattern='^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
    echo ''
    echo '  ✗ Commit message does not follow Conventional Commits'
    echo ''
    echo "    got:      $first_line"
    echo '    expected: <type>(<scope>): <subject>'
    echo ''
    echo '    types:    feat fix docs style refactor perf test chore ci revert'
    echo '    examples: feat(api): add user endpoint'
    echo '              fix: handle empty payload'
    echo ''
    exit 1
fi

# Subject must not start with a capital, matching the commitlint rules.
subject=${first_line#*: }
case "$subject" in
    [A-Z]*)
        echo ''
        echo '  ✗ Subject must not start with a capital letter'
        echo "    got: $subject"
        echo ''
        exit 1
        ;;
esac

# Subject must not end with a period.
case "$subject" in
    *.)
        echo ''
        echo '  ✗ Subject must not end with a period'
        echo "    got: $subject"
        echo ''
        exit 1
        ;;
esac

if [ ${#first_line} -gt 100 ]; then
    echo ''
    echo "  ✗ Header is ${#first_line} characters; the limit is 100"
    echo ''
    exit 1
fi
